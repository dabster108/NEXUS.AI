# Copy to .env and fill in. Never commit .env.
#
# First live run (after keys):
#   uv run python -m src --check
#   uv run python -m src --approve          # smoke + Langfuse
#
# No Langfuse keys yet (still LIVE: real model calls, and --approve really
# approves CONFIRM tools such as opening apps on this Mac):
#   uv run python -m src --dry-run --approve
#
# Offline, no backend and no model: `uv run pytest` and `uv run python -m src --check`.

# --- Langfuse ------------------------------------------------------------
# Cloud: https://cloud.langfuse.com → Project → Settings → API Keys
# Match the region of your project (US projects need the US host):
#   EU: https://cloud.langfuse.com
#   US: https://us.cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_ENVIRONMENT=dev

# --- NEXUS backend -------------------------------------------------------
NEXUS_API_URL=http://127.0.0.1:8000
